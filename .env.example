# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configurations
MONGO_URI=mongodb://localhost:27017/scenecraft
REDIS_URL=redis://localhost:6379

# Authentication Secrets
JWT_ACCESS_SECRET=your_super_secret_access_token_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# File Upload Configurations
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads/
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain

# Storage Service Configuration (local or s3)
STORAGE_PROVIDER=local

# AWS S3 Configurations (Required only if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=

# AI Provider Configurations (gemini or openai)
AI_PROVIDER=gemini

# Provider Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-004
